# Copy to .env.local for local dev; set the same values in Vercel → Project → Settings → Environment Variables.

# Formspree form endpoint (lead emails)
VITE_FORMSPREE_URL=https://formspree.io/f/xxxxxxxx

# Google Apps Script web app that writes leads into the Enquiries tab.
# Leave blank to disable. Setup: integrations/enquiries-sheet/README.md
VITE_ENQUIRIES_WEBHOOK_URL=
# Must equal the ENQUIRIES_TOKEN script property. It ships in the browser bundle,
# so it only stops casual spam — it is not a secret.
VITE_ENQUIRIES_TOKEN=
